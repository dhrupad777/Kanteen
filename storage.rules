rules_version = '2';

// Cloud Storage rules.
//
// Storage was initialised in lib/firebase.ts but never actually used until the
// student banner, so this file starts from "deny everything" and opens exactly one
// path. Anything added later needs its own block — the catch-all at the bottom means
// a new feature fails closed rather than inheriting access it was never granted.

service firebase.storage {
  match /b/{bucket}/o {

    // ---------- Student dashboard banner ----------
    // Uploaded from /report (owner only) and shown to every student.
    match /banners/{fileName} {
      // Public read is required, not just convenient: next/Image optimises this URL
      // server-side and fetches it without the student's credentials. An auth-gated
      // read would make the optimiser fail and the banner never render. The content
      // is a public-facing promotional image, so there is nothing to protect.
      allow read: if true;

      // Writes are owner-only, matching the gate on /report itself (isOwner is the
      // custom claim minted by /api/auth/staff-login). Kitchen and counter staff can
      // sign in but have no business changing what the whole campus sees.
      //
      // Size and content type are enforced here as well as in the UI: the client
      // check is a courtesy, this is the control. 5 MB is generous for a banner and
      // small enough that a mistake cannot fill the bucket.
      allow write: if request.auth != null
                   && request.auth.token.isOwner == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ---------- Student leaderboard avatars ----------
    // A student may replace the Google profile picture shown next to their name on
    // the leaderboard. Opt-in and self-service; nothing prompts them to set one.
    match /avatars/{userId}/{fileName} {
      // Public read, for the same reason as banners: these render for every student
      // on the board, and the uploader's credentials are not involved in that fetch.
      allow read: if true;

      // Write only to your OWN folder. This is the control that stops a student
      // replacing someone else's picture - the path segment is matched against the
      // caller's uid, so there is no way to write outside it.
      //
      // 300 KB is far above what the client produces (it re-encodes to a 256px WebP,
      // typically 10-20 KB) and is here to bound a hand-crafted upload, not the app.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 300 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ---------- Everything else ----------
    // No other path is in use. Deny rather than leave the bucket open.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
