rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isManager() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/manager_allowlist/$(request.auth.token.email.lower()));
    }

    match /orders/{orderId} {
      allow read: if 
        (resource.data.status == 'Ready' && resource.data.token < 201) ||
        (request.auth != null && (resource.data.studentId == request.auth.uid || isManager()));
      allow create, update, delete: if isManager();
    }

    match /order_counters/{date} {
      allow read: if isManager();
      allow write: if false; // Only via API (Admin SDK)
    }

    match /metadata/{docId} {
      allow read: if isManager();
      allow write: if isManager();
    }

    match /students/{userId} {
      allow create, update, read: if request.auth != null && request.auth.uid == userId;
      allow delete, list: if false;
    }

    match /manager_allowlist/{email} {
      allow read: if request.auth != null;   // ✅ allows get + onSnapshot doc reads
      allow write: if false;
    }

    match /menu_options/{category} {
      allow read: if true;
      allow write: if isManager();
    }

    match /canteen_state/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Orderable menu catalog - public read for students browsing
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /managers/{userId} {
      allow create, update, read: if request.auth != null && request.auth.uid == userId;
      allow delete, list: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete, list: if false;
    }

    match /daily_reports/{reportId} {
      allow read, write: if isManager();
    }
  }
}
