rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // PRODUCTION SECURITY RULES
    // ============================================================

    function isManager() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/manager_allowlist/$(request.auth.token.email.lower()));
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Orders - Students can read their own, managers can read/update all
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isManager());
      allow create: if false; // Only via API routes (server-side)
      allow update: if isManager(); // Kitchen staff updates
      allow delete: if isManager();
    }

    // Order counters - Managers only
    match /order_counters/{date} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Admin SDK
    }

    // Metadata - Managers only
    match /metadata/{docId} {
      allow read: if isManager();
      allow write: if isManager();
    }

    // Student profiles - Owner only
    match /students/{userId} {
      allow create, update, read: if isOwner(userId);
      allow delete, list: if false;
    }

    // Users collection - Owner only
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow delete, list: if false;
    }

    // Manager allowlist - Read for auth check
    match /manager_allowlist/{email} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Firebase Console
    }

    // Menu options - Public read, manager write
    match /menu_options/{category} {
      allow read: if true;
      allow write: if isManager();
    }

    // Canteen state - Public read, manager write
    match /canteen_state/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Menu items catalog - Public read for browsing
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Manager profiles - Owner only
    match /managers/{userId} {
      allow create, update, read: if isOwner(userId);
      allow delete, list: if false;
    }

    // Daily reports - Manager read only
    match /daily_reports/{reportId} {
      allow read: if isManager();
      allow write: if false; // Only via Admin SDK
    }
  }
}
