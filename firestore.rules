rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // PRODUCTION SECURITY RULES WITH RBAC
    // ============================================================

    // ====== ROLE CHECKING FUNCTIONS ======
    
    // Check if user has specific role via custom claims
    function hasRole(role) {
      return request.auth != null 
        && request.auth.token.role == role;
    }

    // Check if user is any kitchen staff (staff or manager)
    function isKitchenStaff() {
      return request.auth != null 
        && (request.auth.token.role in ['kitchen_staff', 'kitchen_manager', 'admin']);
    }

    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Legacy manager check (fallback for backward compatibility)
    function isManagerLegacy() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/manager_allowlist/$(request.auth.token.email.lower()));
    }

    // Combined manager check (RBAC + legacy fallback)
    function isManager() {
      return isKitchenStaff() || isManagerLegacy();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ====== FIELD RESTRICTION HELPERS ======
    
    // Check if only allowed fields are being modified
    function onlyModifiesFields(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    function profileKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        'uid', 'name', 'email', 'photoURL', 'createdAt', 'lastLoginAt', 'updatedAt'
      ]);
    }

    // ====== ORDERS COLLECTION ======
    match /orders/{orderId} {
      // Staff with token-based role can read all orders (collection queries work).
      // Students can read their own orders or any Preparing/Ready order.
      // isManagerLegacy (allowlist exists() check) is intentionally excluded from
      // collection queries — Firestore cannot evaluate per-document exists() calls
      // on a query and will deny the whole query.
      allow read: if isKitchenStaff()
        || (isAuthenticated()
            && (resource.data.studentId == request.auth.uid
                || resource.data.status in ['Preparing', 'Ready']));
      
      // Only server (Admin SDK) can create orders
      allow create: if false;
      
      // Staff can only update specific fields (token-based check only for reliable evaluation)
      allow update: if isKitchenStaff()
        && onlyModifiesFields(['status', 'kitchen', 'otp', 'audit']);
      
      // Admin or kitchen_manager can delete (for end-of-day order cleanup)
      allow delete: if isAdmin() || hasRole('kitchen_manager');
    }

    // ====== FEEDBACK ======
    // General student feedback (not tied to an order). Written only via the
    // Admin SDK (POST /api/feedback), which derives the submitter's identity
    // from a verified ID token. isManagerLegacy is intentionally excluded —
    // its exists() lookup makes Firestore deny the whole collection query
    // (same caveat as /orders above).
    match /feedback/{feedbackId} {
      allow read: if isKitchenStaff();
      allow write: if false; // Only via Admin SDK
    }

    // ====== ORDER COUNTERS ======
    match /order_counters/{date} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Admin SDK
    }

    // ====== WEBHOOK EVENTS (for deduplication) ======
    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Admin SDK
    }

    // ====== AUDIT LOGS ======
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Admin SDK
    }

    // ====== PRINT JOBS ======
    match /print_jobs/{jobId} {
      allow read: if isKitchenStaff();
      // kitchen_manager can delete print_jobs directly (batch cleanup from OrderCleanup component)
      allow delete: if hasRole('kitchen_manager') || isAdmin();
      allow create, update: if false; // Only via Admin SDK
    }

    // ====== METADATA ======
    match /metadata/{docId} {
      allow read: if isManager();
      allow write: if isManager();
    }

    // ====== STUDENT PROFILES ======
    match /students/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && profileKeysAllowed();
      allow update: if isOwner(userId)
        && onlyModifiesFields(['name', 'email', 'photoURL', 'lastLoginAt', 'updatedAt']);
      allow delete, list: if false;
    }

    // ====== USER PROFILES ======
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && profileKeysAllowed();
      allow update: if isOwner(userId)
        && onlyModifiesFields(['name', 'email', 'photoURL', 'lastLoginAt', 'updatedAt']);
      allow delete, list: if false;
    }

    // ====== MANAGER ALLOWLIST ======
    match /manager_allowlist/{email} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Firebase Console or Admin SDK
    }

    // ====== MENU OPTIONS ======
    match /menu_options/{category} {
      allow read: if true;
      allow write: if isManager();
    }

    // ====== CANTEEN STATE ======
    match /canteen_state/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ====== MENU ITEMS ======
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ====== MANAGER PROFILES ======
    match /managers/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && profileKeysAllowed();
      allow update: if isOwner(userId)
        && onlyModifiesFields(['name', 'email', 'photoURL', 'lastLoginAt', 'updatedAt']);
      allow delete, list: if false;
    }

    // ====== DAILY REPORTS ======
    match /daily_reports/{reportId} {
      allow read: if isManager();
      allow write: if false; // Only via Admin SDK
    }

    // ====== STAFF CREDENTIALS (server-side only) ======
    // Stores plain-text email + password for /counter, /kitchen, /report login.
    // Readable/writable ONLY via Firebase Admin SDK (API route: /api/auth/staff-login).
    // Change passwords directly in Firebase Console → Firestore → staff_credentials → config.
    match /staff_credentials/{docId} {
      allow read, write: if false;
    }

    // ====== STAFF SESSIONS (reserved) ======
    match /staff_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Web Push endpoints — written only via Admin SDK (/api/push/*)
    match /push_subscriptions/{docId} {
      allow read, write: if false;
    }

    // Default deny for any collection not listed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
