rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // PRODUCTION SECURITY RULES WITH RBAC
    // ============================================================

    // ====== ROLE CHECKING FUNCTIONS ======
    
    // Check if user has specific role via custom claims
    function hasRole(role) {
      return request.auth != null 
        && request.auth.token.role == role;
    }

    // Check if user is any kitchen staff (staff or manager)
    function isKitchenStaff() {
      return request.auth != null 
        && (request.auth.token.role in ['kitchen_staff', 'kitchen_manager', 'admin']);
    }

    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Legacy manager check (fallback for backward compatibility)
    function isManagerLegacy() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/manager_allowlist/$(request.auth.token.email.lower()));
    }

    // Combined manager check (RBAC + legacy fallback)
    function isManager() {
      return isKitchenStaff() || isManagerLegacy();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ====== FIELD RESTRICTION HELPERS ======
    
    // Check if only allowed fields are being modified
    function onlyModifiesFields(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ====== ORDERS COLLECTION ======
    match /orders/{orderId} {
      // Students can read their own orders or any Preparing/Ready order (for public board)
      // Staff/managers can read all orders
      allow read: if isAuthenticated()
        && (resource.data.studentId == request.auth.uid
            || isManager()
            || resource.data.status in ['Preparing', 'Ready']);
      
      // Only server (Admin SDK) can create orders
      allow create: if false;
      
      // Staff can only update specific fields
      allow update: if isManager() 
        && onlyModifiesFields(['status', 'kitchen', 'otp', 'audit']);
      
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // ====== ORDER COUNTERS ======
    match /order_counters/{date} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Admin SDK
    }

    // ====== WEBHOOK EVENTS (for deduplication) ======
    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Admin SDK
    }

    // ====== AUDIT LOGS ======
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Admin SDK
    }

    // ====== PRINT JOBS ======
    match /print_jobs/{jobId} {
      allow read: if isManager(); // Kitchen staff need real-time listener access
      allow write: if false; // Only via Admin SDK (claim/complete/fail go through API routes)
    }

    // ====== METADATA ======
    match /metadata/{docId} {
      allow read: if isManager();
      allow write: if isManager();
    }

    // ====== STUDENT PROFILES ======
    match /students/{userId} {
      allow create, update, read: if isOwner(userId);
      allow delete, list: if false;
    }

    // ====== USER PROFILES ======
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow delete, list: if false;
    }

    // ====== MANAGER ALLOWLIST ======
    match /manager_allowlist/{email} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Firebase Console or Admin SDK
    }

    // ====== MENU OPTIONS ======
    match /menu_options/{category} {
      allow read: if true;
      allow write: if isManager();
    }

    // ====== CANTEEN STATE ======
    match /canteen_state/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ====== MENU ITEMS ======
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ====== MANAGER PROFILES ======
    match /managers/{userId} {
      allow create, update, read: if isOwner(userId);
      allow delete, list: if false;
    }

    // ====== DAILY REPORTS ======
    match /daily_reports/{reportId} {
      allow read: if isManager();
      allow write: if false; // Only via Admin SDK
    }

    // ====== STAFF CREDENTIALS (server-side only) ======
    // Stores plain-text email + password for /counter, /kitchen, /report login.
    // Readable/writable ONLY via Firebase Admin SDK (API route: /api/auth/staff-login).
    // Change passwords directly in Firebase Console → Firestore → staff_credentials → config.
    match /staff_credentials/{docId} {
      allow read, write: if false;
    }

    // ====== STAFF SESSIONS (reserved) ======
    match /staff_sessions/{sessionId} {
      allow read, write: if false;
    }
  }
}
