# Settings for Backend (on Cloud Run).
# See https://firebase.google.com/docs/app-hosting/configure#cloud-run
#
# IMPORTANT: Copy this to apphosting.yaml and fill in your values.
# NEVER commit apphosting.yaml to git - it contains secrets!

runConfig:
  minInstances: 0
  maxInstances: 10
  concurrency: 80
  cpu: 1
  memoryMiB: 512

# Environment variables and secrets.
env:
  # Firebase Configuration (public - but regenerate after exposure)
  - variable: NEXT_PUBLIC_FIREBASE_API_KEY
    value: YOUR_NEW_FIREBASE_API_KEY
    availability:
      - BUILD
      - RUNTIME

  - variable: NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
    value: YOUR_PROJECT_ID.firebaseapp.com
    availability:
      - BUILD
      - RUNTIME

  - variable: NEXT_PUBLIC_FIREBASE_PROJECT_ID
    value: YOUR_PROJECT_ID
    availability:
      - BUILD
      - RUNTIME

  - variable: NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
    value: YOUR_PROJECT_ID.firebasestorage.app
    availability:
      - BUILD
      - RUNTIME

  - variable: NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
    value: "YOUR_SENDER_ID"
    availability:
      - BUILD
      - RUNTIME

  - variable: NEXT_PUBLIC_FIREBASE_APP_ID
    value: YOUR_APP_ID
    availability:
      - BUILD
      - RUNTIME

  # Auth bypass (must be false in production!)
  - variable: NEXT_PUBLIC_BYPASS_AUTH
    value: "false"
    availability:
      - BUILD
      - RUNTIME

  # Razorpay Public Key (visible to browser - still regenerate after exposure)
  - variable: NEXT_PUBLIC_RAZORPAY_KEY_ID
    value: rzp_live_YOUR_NEW_KEY
    availability:
      - BUILD
      - RUNTIME

  # ============================================================
  # SECRETS - Use Firebase App Hosting Secrets for these!
  # Run: firebase apphosting:secrets:set RAZORPAY_KEY_SECRET
  # ============================================================

  - variable: RAZORPAY_KEY_ID
    value: rzp_live_YOUR_NEW_KEY
    availability:
      - RUNTIME

  # CRITICAL: Use secrets manager instead of plain text!
  # firebase apphosting:secrets:set RAZORPAY_KEY_SECRET
  - variable: RAZORPAY_KEY_SECRET
    secret: RAZORPAY_KEY_SECRET
    # value: NEVER_PUT_SECRET_HERE

  # firebase apphosting:secrets:set RAZORPAY_WEBHOOK_SECRET
  - variable: RAZORPAY_WEBHOOK_SECRET
    secret: RAZORPAY_WEBHOOK_SECRET
    # value: NEVER_PUT_SECRET_HERE
